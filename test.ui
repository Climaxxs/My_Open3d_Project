 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">

  <!-- ==================== 窗口基本属性 ==================== -->
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1400</width>
    <height>900</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>家畜点云尺寸测量系统</string>
  </property>

  <!-- ==================== 全局样式表 ==================== -->
  <property name="styleSheet">
   <string notr="true">
    /* 主窗口样式 */
    QMainWindow {
        background-color: #1e1e1e;
    }

    /* 面板通用样式 */
    QFrame {
        background-color: #2d2d2d;
        border-radius: 10px;
        margin: 5px;
    }

    /* 左侧面板 */
    #leftPanel {
        background-color: #252525;
        border-right: 1px solid #3d3d3d;
        border-radius: 0;
        margin: 0;
    }

    /* 中心面板 */
    #centerPanel {
        background-color: #1e1e1e;
    }

    /* 右侧面板 */
    #rightPanel {
        background-color: #252525;
        border-left: 1px solid #3d3d3d;
        border-radius: 0;
        margin: 0;
    }

    /* 按钮样式 */
    QPushButton {
        background-color: #3c3c3c;
        border: none;
        border-radius: 8px;
        color: #ffffff;
        font-size: 14px;
        font-weight: bold;
        padding: 10px 20px;
        text-align: left;
        min-height: 35px;
    }

    QPushButton:hover {
        background-color: #4a4a4a;
        padding-left: 25px;
        transition: all 0.3s;
    }

    QPushButton:pressed {
        background-color: #2a2a2a;
    }

    /* 特殊按钮样式 */
    /* 导入按钮 - 蓝色主题 */
    #btnLoad {
        background-color: #0078d4;
        color: white;
    }

    #btnLoad:hover {
        background-color: #106ebe;
    }

    /* 测量按钮 - 绿色主题 */
    #btnMeasure, #btnMultiMeasure, #btnAuto {
        background-color: #2d5a2d;
    }

    #btnMeasure:hover, #btnMultiMeasure:hover, #btnAuto:hover {
        background-color: #3d6a3d;
    }

    /* 保存按钮 - 深绿色 */
    #btnSave {
        background-color: #107c10;
    }

    #btnSave:hover {
        background-color: #208c20;
    }

    /* 清空按钮 - 橙色警告色 */
    #btnClear {
        background-color: #d83b01;
    }

    #btnClear:hover {
        background-color: #e84b11;
    }

    /* 表格样式 */
    QTableWidget {
        background-color: #2d2d2d;
        border: none;
        border-radius: 8px;
        gridline-color: #3d3d3d;
        color: #ffffff;
        font-size: 12px;
    }

    QTableWidget::item {
        padding: 8px;
        border-bottom: 1px solid #3d3d3d;
    }

    QTableWidget::item:selected {
        background-color: #0078d4;
    }

    QHeaderView::section {
        background-color: #3c3c3c;
        padding: 8px;
        border: none;
        color: #ffffff;
        font-weight: bold;
    }

    /* 标签样式 */
    QLabel {
        color: #e0e0e0;
        font-size: 13px;
        font-weight: bold;
    }

    #labelTitle {
        font-size: 18px;
        font-weight: bold;
        color: #0078d4;
        padding: 10px;
        border-bottom: 2px solid #0078d4;
    }

    /* 文本编辑框 */
    QTextEdit, QLineEdit {
        background-color: #1e1e1e;
        border: 1px solid #3d3d3d;
        border-radius: 6px;
        color: #ffffff;
        font-size: 12px;
        padding: 8px;
    }

    QTextEdit:focus, QLineEdit:focus {
        border: 1px solid #0078d4;
        background-color: #252525;
    }

    /* 滚动条 */
    QScrollBar:vertical {
        background-color: #2d2d2d;
        width: 10px;
        border-radius: 5px;
    }

    QScrollBar::handle:vertical {
        background-color: #5a5a5a;
        border-radius: 5px;
        min-height: 20px;
    }

    QScrollBar::handle:vertical:hover {
        background-color: #6a6a6a;
    }

    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        border: none;
        background: none;
    }

    /* 视图框架 */
    #viewFrame {
        background-color: #1a1a1a;
        border: 1px solid #3d3d3d;
        border-radius: 8px;
    }

    /* 分组框样式 */
    QGroupBox {
        color: #ffffff;
        border: 1px solid #3d3d3d;
        border-radius: 8px;
        margin-top: 15px;
        padding-top: 10px;
    }

    QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 5px 0 5px;
    }
   </string>
  </property>

